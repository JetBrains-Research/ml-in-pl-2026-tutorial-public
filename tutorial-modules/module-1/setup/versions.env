# One place for every pinned version the local deployment uses. The orchestrator, watcher,
# server image, chart, and Python client all have to come from the same IdeGYM release.
IDEGYM_VERSION=0.13.0
IDEGYM_CHART=oci://ghcr.io/jetbrains-research/idegym/idegym
KUBERNETES_VERSION=v1.35.1
POSTGRES_IMAGE=registry-1.docker.io/bitnami/postgresql:latest
MINIKUBE_CPUS=4
MINIKUBE_MEMORY=8g
