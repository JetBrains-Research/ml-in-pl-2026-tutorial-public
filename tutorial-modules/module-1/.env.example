# Copy to .env (gitignored). Every sketch reads this one file.
# Never commit real values.

# --- Steps 1-3: the local cluster, after `kubectl port-forward svc/idegym 8000:80 -n idegym` ---
# A local install has no authentication, but idegym-client refuses to start without credentials
# for any URL other than http://idegym.test, so any placeholder works.
IDEGYM_ORCHESTRATOR_URL=http://localhost:8000
IDEGYM_AUTH_USERNAME=local
IDEGYM_AUTH_PASSWORD=local
IDEGYM_NAMESPACE=idegym

# --- Step 4 onwards: the shared workshop cluster ---
# Replace the four values above with the ones handed out at the workshop.

# Name the client after yourself so your servers are easy to find on the dashboard.
IDEGYM_CLIENT_NAME=ml-in-pl-your-name
